{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized staff member granted access to the Speedy Burger admin dashboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the staff member.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified staff Google email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Staff display name shown inside the admin dashboard.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "staff"],
          "description": "Staff permission tier.",
          "maxLength": 20
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the administrator who granted staff access.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when staff access was created."
        }
      },
      "required": ["uid", "email", "displayName", "role", "addedBy", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Public storefront configuration, appearance theme, loyalty rules, pages, labels, and ticket text.",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "whatsappNumber": { "type": "string", "minLength": 5, "maxLength": 24, "pattern": "^[0-9+\\-\\s()]+$" },
        "estimatedWaitMins": { "type": "number" },
        "orderingEnabled": { "type": "boolean" },
        "pickupEnabled": { "type": "boolean" },
        "deliveryEnabled": { "type": "boolean" },
        "currencySymbol": { "type": "string", "minLength": 1, "maxLength": 8 },
        "ordersNeededForReward": { "type": "number" },
        "rewardText": { "type": "string", "maxLength": 160 },
        "membershipPrice": { "type": "number" },
        "clubEnabled": { "type": "boolean" },
        "darkMode": { "type": "boolean" },
        "brandColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "accentColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "crownColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "textColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "headingFont": { "type": "string", "maxLength": 80 },
        "bodyFont": { "type": "string", "maxLength": 80 },
        "animationsEnabled": { "type": "boolean" },
        "animationScale": { "type": "number" },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "aboutHeading": { "type": "string", "maxLength": 120 },
        "aboutBody": { "type": "string", "maxLength": 2000 },
        "aboutHighlight": { "type": "string", "maxLength": 300 },
        "contactHeading": { "type": "string", "maxLength": 120 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "contactEmail": { "type": "string", "maxLength": 120 },
        "contactAddress": { "type": "string", "maxLength": 240 },
        "contactHours": { "type": "string", "maxLength": 160 },
        "contactNote": { "type": "string", "maxLength": 600 },
        "splashEnabled": { "type": "boolean" },
        "splashTitle": { "type": "string", "maxLength": 120 },
        "splashTagline": { "type": "string", "maxLength": 240 },
        "splashCtaText": { "type": "string", "maxLength": 60 },
        "splashImageUrl": { "type": "string", "maxLength": 500 },
        "footerText": { "type": "string", "maxLength": 240 },
        "footerSubtext": { "type": "string", "maxLength": 240 },
        "tagline": { "type": "string", "maxLength": 120 },
        "tabCombos": { "type": "string", "maxLength": 40 },
        "tabBuild": { "type": "string", "maxLength": 40 },
        "tabOrders": { "type": "string", "maxLength": 40 },
        "tabCard": { "type": "string", "maxLength": 40 },
        "tabClub": { "type": "string", "maxLength": 40 },
        "pickBarComboText": { "type": "string", "maxLength": 60 },
        "pickBarBuildText": { "type": "string", "maxLength": 60 },
        "viewOrderText": { "type": "string", "maxLength": 60 },
        "ticketHeading": { "type": "string", "maxLength": 80 },
        "ticketWaitLabel": { "type": "string", "maxLength": 60 },
        "ticketWhatsappText": { "type": "string", "maxLength": 60 },
        "ticketBackText": { "type": "string", "maxLength": 60 },
        "ticketFooterNote": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "shopName",
        "whatsappNumber",
        "estimatedWaitMins",
        "orderingEnabled",
        "pickupEnabled",
        "deliveryEnabled",
        "currencySymbol",
        "ordersNeededForReward",
        "rewardText",
        "membershipPrice",
        "clubEnabled",
        "darkMode",
        "brandColor",
        "accentColor",
        "crownColor",
        "backgroundColor",
        "textColor",
        "headingFont",
        "bodyFont",
        "animationsEnabled",
        "animationScale",
        "logoUrl",
        "aboutHeading",
        "aboutBody",
        "aboutHighlight",
        "contactHeading",
        "contactPhone",
        "contactEmail",
        "contactAddress",
        "contactHours",
        "contactNote",
        "splashEnabled",
        "splashTitle",
        "splashTagline",
        "splashCtaText",
        "splashImageUrl",
        "footerText",
        "footerSubtext",
        "tagline",
        "tabCombos",
        "tabBuild",
        "tabOrders",
        "tabCard",
        "tabClub",
        "pickBarComboText",
        "pickBarBuildText",
        "viewOrderText",
        "ticketHeading",
        "ticketWaitLabel",
        "ticketWhatsappText",
        "ticketBackText",
        "ticketFooterNote",
        "updatedAt",
        "updatedBy"
      ]
    },
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "Menu builder or combo category with sort order and availability.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "key": { "type": "string", "enum": ["bun", "meat", "cheese", "toppings", "sauces", "sides", "combos"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "selectionMode": { "type": "string", "enum": ["single", "multi"] },
        "sortOrder": { "type": "number" },
        "available": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "key", "name", "selectionMode", "sortOrder", "available", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Individual burger ingredient, side, or combo item managed by staff.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryKey": { "type": "string", "enum": ["bun", "meat", "cheese", "toppings", "sauces", "sides", "combos"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 },
        "swatch": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "visualKey": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "maxQty": { "type": "number" },
        "sortOrder": { "type": "number" },
        "available": { "type": "boolean" },
        "comboBun": { "type": "string", "maxLength": 64 },
        "comboIngredients": { "type": "array", "description": "Bounded list of ingredient tokens e.g. meat:beef:1" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "categoryKey", "name", "price", "description", "swatch", "visualKey", "maxQty", "sortOrder", "available", "comboBun", "comboIngredients", "updatedAt"]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "Customer order ticket stored for kitchen fulfillment and staff order management.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ticketCode": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "deliveryAddress": { "type": "string", "maxLength": 240 },
        "orderMode": { "type": "string", "enum": ["Pickup", "Delivery"] },
        "comboName": { "type": "string", "maxLength": 80 },
        "items": { "type": "array", "description": "Bounded list of order line strings." },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "ready", "completed", "cancelled"] },
        "notes": { "type": "string", "maxLength": 300 },
        "staffNote": { "type": "string", "maxLength": 300 },
        "approved": { "type": "boolean", "description": "Whether staff approved this order to count toward total revenue." },
        "approvedBy": { "type": "string", "maxLength": 128, "description": "Staff UID that approved the order." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "ticketCode",
        "customerName",
        "customerPhone",
        "deliveryAddress",
        "orderMode",
        "comboName",
        "items",
        "total",
        "status",
        "notes",
        "staffNote",
        "approved",
        "approvedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BurgerClubMember": {
      "title": "BurgerClubMember",
      "description": "Burger Club loyalty member record containing punch card progress and priority membership.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "stamps": { "type": "number" },
        "lifetimeOrders": { "type": "number" },
        "rewardsRedeemed": { "type": "number" },
        "firstInLine": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "name",
        "phone",
        "email",
        "stamps",
        "lifetimeOrders",
        "rewardsRedeemed",
        "firstInLine",
        "status",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "SpeedyPet": {
      "title": "SpeedyPet",
      "description": "User-customized 3D Talking-Tom-style animal Speedy Pet mascot with daily feeding and order-sync care state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "species": {
          "type": "string",
          "enum": [
            "shadow_tux",
            "pink_hero",
            "kid_speed",
            "reverse_bolt",
            "blue_dash",
            "crimson_bolt",
            "cat",
            "dog",
            "bunny",
            "bear",
            "fox",
            "lion"
          ]
        },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "furColor": { "type": "string", "minLength": 1, "maxLength": 40 },
        "hairStyle": { "type": "string", "minLength": 1, "maxLength": 40 },
        "hairColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "eyeStyle": { "type": "string", "minLength": 1, "maxLength": 40 },
        "eyeColor": { "type": "string", "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "eyebrowStyle": { "type": "string", "minLength": 1, "maxLength": 40 },
        "expression": { "type": "string", "minLength": 1, "maxLength": 40 },
        "facialHair": { "type": "string", "minLength": 1, "maxLength": 40 },
        "topId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "bottomId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "footwearId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "accessories": { "type": "array", "description": "Bounded list of selected accessory IDs." },
        "lastFedAt": { "type": "number" },
        "happiness": { "type": "number" },
        "streakDays": { "type": "number" },
        "totalMealsEaten": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "lastMealName": { "type": "string", "maxLength": 120 },
        "lastMealItems": { "type": "array", "description": "Bounded list of food items shared from the latest meal or order." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "name",
        "species",
        "gender",
        "furColor",
        "hairStyle",
        "hairColor",
        "eyeStyle",
        "eyeColor",
        "eyebrowStyle",
        "expression",
        "facialHair",
        "topId",
        "bottomId",
        "footwearId",
        "accessories",
        "lastFedAt",
        "happiness",
        "streakDays",
        "totalMealsEaten",
        "xp",
        "level",
        "lastMealName",
        "lastMealItems",
        "createdAt",
        "updatedAt"
      ]
    },
    "RevenueEntry": {
      "title": "RevenueEntry",
      "description": "Walk-in, WhatsApp, catering, or Burger Club membership sale logged by staff that must be approved before adding to total revenue.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["walk_in", "whatsapp", "club_fee", "catering", "other"] },
        "amount": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "approved": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "category",
        "amount",
        "note",
        "approved",
        "createdBy",
        "approvedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin staff registry."
    },
    "/siteSettings/public": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Public storefront appearance, pages, labels, ticket text, and loyalty rules."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/MenuCategory" },
      "description": "Menu categories and availability flags."
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu items, prices, descriptions, and availability."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Customer order tickets with PII isolated to owner and authorized staff."
    },
    "/burgerClub/{memberId}": {
      "schema": { "$ref": "#/entities/BurgerClubMember" },
      "description": "Burger Club loyalty members and stamp cards."
    },
    "/speedyPets/{petId}": {
      "schema": { "$ref": "#/entities/SpeedyPet" },
      "description": "Saved custom 3D Speedy Pet brand mascots owned by users."
    },
    "/revenueEntries/{entryId}": {
      "schema": { "$ref": "#/entities/RevenueEntry" },
      "description": "Staff-logged offline/walk-in/membership revenue entries requiring dashboard approval."
    }
  }
}
